# Local development
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
VITE_PLATFORM_MODE=false
VITE_PLATFORM_API_URL=

# Local development must identify which tenant the public website represents.
# Choose one active tenant slug from the database; never guess or use a secret.
# VITE_PUBLIC_TENANT_SLUG=amani-trails-safaris

# Production / platform deployment
# VITE_PLATFORM_MODE=true
# VITE_PLATFORM_API_URL=https://your-api-domain.example/api

# Tenant deployments can set these values as required:
# VITE_API_URL=https://your-api-domain.example/api
# VITE_SOCKET_URL=https://your-api-domain.example
# VITE_PLATFORM_HOST=globaltours.com
# VITE_PUBLIC_TENANT_SLUG=
# VITE_PUBLIC_TENANT_KEY=
