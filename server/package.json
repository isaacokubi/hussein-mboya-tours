{
  "name": "hussein-mboya-tours-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node --check server.js",
    "lint": "npm run check",
    "repair:guides": "node scripts/repairGuideStaffProfiles.js",
    "repair:roles": "node scripts/repairRoleReferences.js",
    "seed:staff": "node scripts/seedStaffVehicles.js",
    "create:admin": "node scripts/createAdmin.js",
    "reset:superadmin": "node scripts/resetSuperAdmin.js",
    "check:controllers": "node --check controllers/bookingAdminController.js && node --check controllers/adminBookingController.js && node --check controllers/agentBookingController.js && node --check controllers/bookingController.js && node --check controllers/tourManagerController.js && node --check controllers/mpesaController.js && node --check controllers/mpesaRefundController.js && node --check controllers/stripeController.js && node --check controllers/adminPaymentController.js && node --check controllers/paymentController.js",
    "check:models": "node --check models/Booking.js && node --check models/Payment.js",
    "check:rbac": "node scripts/rbac-contract-check.js",
    "check:security": "node scripts/security-hardening-check.js",
    "check:all": "npm run check && npm run check:controllers && npm run check:models && npm run check:rbac && npm run check:security"
  },
  "dependencies": {
    "africastalking": "^0.8.0",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "i18next": "^26.3.6",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^8.12.1",
    "mongoose-paginate-v2": "^1.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "openai": "^7.4.0",
    "pdfkit": "^0.19.0",
    "qrcode": "^1.5.4",
    "react-i18next": "^17.0.11",
    "sitemap": "^9.0.1",
    "slugify": "^1.6.9",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "overrides": {}
