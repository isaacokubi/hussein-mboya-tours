# Purpose: Example environment settings; descriptions explain each configurable deployment value.
# Server environment template
# Copy this file to .env and provide environment-specific values.
# NEVER commit real credentials or production secrets.

# Configure node env for this environment.
NODE_ENV=development
# For isolated Render staging, keep NODE_ENV=production so production security
# settings remain active, set DEPLOYMENT_ENV=staging, and set
# STAGING_DATABASE_NAME to the approved Atlas TEST database name. Never set it
# to the production database name (husseindb).
# Configure port for this environment.
PORT=5000
# Configure mongodb uri for this environment.
MONGODB_URI=
# Required only for the disposable demo seed and password-reset workflow.
# Configure seed demo password for this environment.
SEED_DEMO_PASSWORD=
# Configure deployment env for this environment.
DEPLOYMENT_ENV=production
# Configure staging database name for this environment.
STAGING_DATABASE_NAME=
# Production must use a MongoDB Atlas URI whose path explicitly names husseindb.
# Configure mongodb server selection timeout ms for this environment.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
# Configure mongodb startup migration timeout ms for this environment.
MONGODB_STARTUP_MIGRATION_TIMEOUT_MS=60000
# Configure jwt secret for this environment.
JWT_SECRET=
# Configure jwt expires in for this environment.
JWT_EXPIRES_IN=7d
# Configure mfa enabled for this environment.
MFA_ENABLED=false
# Configure mfa dev mode for this environment.
MFA_DEV_MODE=false

# Application / tenant configuration
# Optional: configure only after the platform owner registers and controls a domain.
PLATFORM_HOST=
# Configure default tenant id for this environment.
DEFAULT_TENANT_ID=
# Configure default public tenant slug for this environment.
DEFAULT_PUBLIC_TENANT_SLUG=
# Development convenience only. MUST be false in production.
# Configure allow single tenant dev fallback for this environment.
ALLOW_SINGLE_TENANT_DEV_FALLBACK=false
# Configure client url for this environment.
CLIENT_URL=http://localhost:5173
# Configure client origins for this environment.
CLIENT_ORIGINS=http://localhost:5173

# Payment credential encryption. Required in production, even before the first tenant configures a provider.
# Use an independent strong random secret (32+ chars); non-production may use JWT_SECRET as compatibility fallback.
# Configure payment credential encryption key for this environment.
PAYMENT_CREDENTIAL_ENCRYPTION_KEY=

# eTIMS credential encryption. REQUIRED in production when eTIMS is configured; use a strong random secret (32+ characters).
# Configure etims credential encryption key for this environment.
ETIMS_CREDENTIAL_ENCRYPTION_KEY=

# Webhook secret encryption/signing. REQUIRED in production; use an independent strong random secret (32+ chars).
# Configure webhook secret key for this environment.
WEBHOOK_SECRET_KEY=
# Configure webhook timeout ms for this environment.
WEBHOOK_TIMEOUT_MS=10000

# Conservative retention controls. Financial/booking evidence is never removed by this scheduler.
# Configure data retention interval ms for this environment.
DATA_RETENTION_INTERVAL_MS=86400000
# Configure background job retention days for this environment.
BACKGROUND_JOB_RETENTION_DAYS=90
# Configure webhook delivery retention days for this environment.
WEBHOOK_DELIVERY_RETENTION_DAYS=180
# Configure privacy request retention days for this environment.
PRIVACY_REQUEST_RETENTION_DAYS=730
# Configure operational record retention days for this environment.
OPERATIONAL_RECORD_RETENTION_DAYS=365

# M-Pesa legacy/platform fallback (OPTIONAL).
# Prefer configuring each tenant from Platform Admin > Dashboard > Companies / Tenants > M-Pesa settings,
# or from that tenant's Admin > Governance > Platform Controls > Payment gateways page.
# Tenant sandbox and production credentials/callbacks are stored in separate encrypted fields.
# Configure MPESA_PRODUCTION_CALLBACK_URL as the production callback route reference.
# MPESA_SANDBOX_CALLBACK_URL optionally names a dedicated Sandbox API callback route.
# If omitted, the verified callback architecture supports an explicitly shared API route:
# callbacks are matched to a persisted tenant/payment attempt and Daraja is queried
# using that attempt's pinned environment before any payment state can change.
# Daraja OAuth validation is non-payment only.
# MUST be false in production.
# Configure allow global mpesa fallback for this environment.
ALLOW_GLOBAL_MPESA_FALLBACK=false
# Configure mpesa environment for this environment.
MPESA_ENVIRONMENT=sandbox
# Configure mpesa sandbox base url for this environment.
MPESA_SANDBOX_BASE_URL=https://sandbox.safaricom.co.ke
# Configure mpesa production base url for this environment.
MPESA_PRODUCTION_BASE_URL=https://api.safaricom.co.ke
# Configure mpesa consumer key for this environment.
MPESA_CONSUMER_KEY=
# Configure mpesa consumer secret for this environment.
MPESA_CONSUMER_SECRET=
# Configure mpesa shortcode for this environment.
MPESA_SHORTCODE=
# Configure mpesa passkey for this environment.
MPESA_PASSKEY=
# Configure mpesa callback url for this environment.
MPESA_CALLBACK_URL=
# Canonical production callback route; also the shared callback reference if no dedicated sandbox host is set.
# Configure mpesa production callback url for this environment.
MPESA_PRODUCTION_CALLBACK_URL=
# Optional dedicated public HTTPS callback route for a separate sandbox API deployment.
# Configure mpesa sandbox callback url for this environment.
MPESA_SANDBOX_CALLBACK_URL=
# Configure mpesa initiator name for this environment.
MPESA_INITIATOR_NAME=
# Configure mpesa security credential for this environment.
MPESA_SECURITY_CREDENTIAL=

# Certified eTIMS/OSCU/VSCU adapter boundary (OPTIONAL until the tenant has completed KRA onboarding/certification).
# The application queues invoices durably and calls only this configured adapter; it does not pretend to be KRA-certified.
# Configure etims adapter url for this environment.
ETIMS_ADAPTER_URL=
# Configure etims adapter token for this environment.
ETIMS_ADAPTER_TOKEN=

# Production go-live evidence gates. Keep false until the corresponding external control has been verified.
# Configure production backup verified for this environment.
PRODUCTION_BACKUP_VERIFIED=false
# Configure production monitoring verified for this environment.
PRODUCTION_MONITORING_VERIFIED=false
# Configure production payment verified for this environment.
PRODUCTION_PAYMENT_VERIFIED=false
# Configure production etims verified for this environment.
PRODUCTION_ETIMS_VERIFIED=false
# Configure production restore tested for this environment.
PRODUCTION_RESTORE_TESTED=false
# Configure production webhooks verified for this environment.
PRODUCTION_WEBHOOKS_VERIFIED=false

# Tenant subscription prices (KES). Set in the deployment environment.
# Configure tenant plan starter price kes for this environment.
TENANT_PLAN_STARTER_PRICE_KES=0
# Configure tenant plan professional price kes for this environment.
TENANT_PLAN_PROFESSIONAL_PRICE_KES=0
# Configure tenant plan business price kes for this environment.
TENANT_PLAN_BUSINESS_PRICE_KES=0
# Configure tenant plan enterprise price kes for this environment.
TENANT_PLAN_ENTERPRISE_PRICE_KES=0

# Stripe
# Configure stripe secret key for this environment.
STRIPE_SECRET_KEY=
# Configure stripe webhook secret for this environment.
STRIPE_WEBHOOK_SECRET=

# Cloudinary
# Optional media provider. Upload and image deletion endpoints return 503 until
# all three Cloudinary values are configured; the API can start without them.
# Configure cloudinary cloud name for this environment.
CLOUDINARY_CLOUD_NAME=
# Configure cloudinary api key for this environment.
CLOUDINARY_API_KEY=
# Configure cloudinary api secret for this environment.
CLOUDINARY_API_SECRET=

# Resend transactional email. The development default sender is onboarding@resend.dev.
# Configure resend api key for this environment.
RESEND_API_KEY=
# Configure resend from email for this environment.
RESEND_FROM_EMAIL=
# Configure resend from name for this environment.
RESEND_FROM_NAME=

# WhatsApp Cloud API (optional)
# Configure whatsapp api url for this environment.
WHATSAPP_API_URL=
# Configure whatsapp access token for this environment.
WHATSAPP_ACCESS_TOKEN=

# Optional AI integration
# Configure openai api key for this environment.
OPENAI_API_KEY=

# Public tenant defaults (optional)
# Configure public tenant key for this environment.
PUBLIC_TENANT_KEY=
# Configure public tenant slug for this environment.
PUBLIC_TENANT_SLUG=

