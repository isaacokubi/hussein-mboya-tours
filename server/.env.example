NODE_ENV=production
PORT=5000

# Firebase / Firestore
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d
MFA_ENABLED=false
MFA_DEV_MODE=false

# Domains / tenancy
PLATFORM_HOST=your-domain.example
DEFAULT_TENANT_ID=
DEFAULT_PUBLIC_TENANT_SLUG=
CLIENT_URL=https://your-frontend-domain.example
CLIENT_ORIGINS=https://your-frontend-domain.example

# Security
PAYMENT_CREDENTIAL_ENCRYPTION_KEY=
ETIMS_CREDENTIAL_ENCRYPTION_KEY=
WEBHOOK_SECRET_KEY=
WEBHOOK_TIMEOUT_MS=10000
ALLOW_SINGLE_TENANT_DEV_FALLBACK=false
ALLOW_GLOBAL_MPESA_FALLBACK=false

# AI
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini

# M-Pesa / Safaricom Daraja
MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-api-domain.example/api/mpesa/callback
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_SECURE=false

# Africa's Talking
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# KRA eTIMS certified adapter
ETIMS_ADAPTER_URL=
ETIMS_ADAPTER_TOKEN=

# Optional seed/bootstrap values (never commit real passwords)
TENANT_ID=
TENANT_SLUG=
TENANT_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
