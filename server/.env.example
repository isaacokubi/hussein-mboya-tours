# ============================================================
# HUSSEIN MBOYA TOURS - SERVER ENVIRONMENT TEMPLATE
# ============================================================
# NEVER put real credentials in this file.
# Copy to .env for local development and fill in real values.
NODE_ENV=development
PORT=5000
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
MFA_ENABLED=false
MFA_DEV_MODE=false
PLATFORM_HOST=globaltours.com
DEFAULT_TENANT_ID=
DEFAULT_PUBLIC_TENANT_SLUG=
ALLOW_SINGLE_TENANT_DEV_FALLBACK=true
CLIENT_URL=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173

# M-Pesa booking + tenant subscription billing
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_SECURITY_CREDENTIAL=

# Tenant subscription prices. Set real prices in the deployment environment; 0 disables STK payment for that plan.
TENANT_PLAN_STARTER_PRICE_KES=0
TENANT_PLAN_PROFESSIONAL_PRICE_KES=0
TENANT_PLAN_BUSINESS_PRICE_KES=0
TENANT_PLAN_ENTERPRISE_PRICE_KES=0

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Customer communication automation
# SMTP_* is supported directly; EMAIL_* aliases are also supported.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Coherent Tours
EMAIL_SECURE=false

# WhatsApp Cloud API (optional; automation falls back to email/in-app when absent)
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=

# Optional AI
OPENAI_API_KEY=
SEED_ADMIN_PASSWORD=
SEED_SUPERADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_AGENT_PASSWORD=
SEED_GUIDE_PASSWORD=
SEED_CUSTOMER_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_FINANCE_PASSWORD=
PUBLIC_TENANT_KEY=global-tours
PUBLIC_TENANT_SLUG=global-tours
