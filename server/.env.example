# ============================================================
# HUSSEIN MBOYA TOURS - SERVER ENVIRONMENT TEMPLATE
# ============================================================
# NEVER put real credentials in this file.
# Copy to .env for local development and fill in real values.

NODE_ENV=development
PORT=5000

MONGODB_URI=

JWT_SECRET=
JWT_EXPIRES_IN=7d

# Multi-tenant platform. Either a default organization ObjectId or a
# public tenant slug may be supplied. The slug is recommended for public
# Vercel deployments with tenant-aware routing.
DEFAULT_TENANT_ID=
DEFAULT_PUBLIC_TENANT_SLUG=

CLIENT_URL=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173

# M-Pesa
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_SECURITY_CREDENTIAL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional AI
OPENAI_API_KEY=

# Seed-only development passwords.
SEED_ADMIN_PASSWORD=
SEED_SUPERADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_AGENT_PASSWORD=
SEED_GUIDE_PASSWORD=
SEED_CUSTOMER_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_FINANCE_PASSWORD=
