# Server environment template
# Copy this file to .env and provide environment-specific values.
# NEVER commit real credentials or production secrets.

NODE_ENV=development
PORT=5000
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
MFA_ENABLED=false
MFA_DEV_MODE=false

# Application / tenant configuration
PLATFORM_HOST=your-domain.com
DEFAULT_TENANT_ID=
DEFAULT_PUBLIC_TENANT_SLUG=
ALLOW_SINGLE_TENANT_DEV_FALLBACK=true
CLIENT_URL=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173

# M-Pesa booking and tenant subscription billing
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_SECURITY_CREDENTIAL=

# Tenant subscription prices (KES). Set in the deployment environment.
TENANT_PLAN_STARTER_PRICE_KES=0
TENANT_PLAN_PROFESSIONAL_PRICE_KES=0
TENANT_PLAN_BUSINESS_PRICE_KES=0
TENANT_PLAN_ENTERPRISE_PRICE_KES=0

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Your Tour Company
EMAIL_SECURE=false

# WhatsApp Cloud API (optional)
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=

# Optional AI integration
OPENAI_API_KEY=

# Public tenant defaults (optional)
PUBLIC_TENANT_KEY=
PUBLIC_TENANT_SLUG=
